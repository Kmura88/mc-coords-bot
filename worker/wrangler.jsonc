{
  "name": "mc-coords",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mc-coords",
      // `npx wrangler d1 create mc-coords --binding DB --update-config` で自動的に書き換わる
      "database_id": "REPLACE_WITH_DATABASE_ID"
    }
  ]
}
